# Every environment variable this site reads. Names only: values live in Vercel and your local .env.
# Paste values as plain text (invisible spaces from docs/chat have broken keys before: rule 24).
# Modules append their variables below with a comment.

# --- starter ---
# Public Supabase project URL + anon (publishable) key. Safe in the browser; RLS protects the data.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server only. Lets the build read private drafts (D8) and server functions write private tables.
SUPABASE_SERVICE_KEY=
# Vercel cron requests carry this; set it so nobody else can call /api/cron/*.
CRON_SECRET=
# Web Analytics needs no key. Turn it on with client.yaml → hosting.analytics: true, then deploy.
# Vercel serves /_vercel/insights/script.js. The CSP allows va.vercel-scripts.com and
# vitals.vercel-insights.com only while that flag is on.

# Email (Resend, D19). Unset RESEND_API_KEY turns all email off; rows record "off".
RESEND_API_KEY=
# Verified sending address on the client's notify subdomain, e.g. "Demo Café <hello@notify.demo-cafe.com>"
EMAIL_FROM=
