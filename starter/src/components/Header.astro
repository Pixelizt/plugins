---
// Site header. Reskin freely. Nav items come from client.yaml → pages (nav: true).
import config from "virtual:kit/config";
import { pageTitle } from "../kit/pages";
const items = config.pages.filter((p) => p.nav && p.path !== "/");
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="border-b border-border">
  <nav class="wrap flex flex-wrap items-center justify-between gap-4 py-4" aria-label="Main">
    <a href="/" class="font-heading text-xl font-bold">{config.client.name}</a>
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {items.map((p) => (
        <li><a href={p.path} aria-current={current === p.path ? "page" : undefined} class="hover:text-primary aria-[current=page]:font-semibold">{pageTitle(p)}</a></li>
      ))}
    </ul>
  </nav>
</header>
