---
// Kit component: canonical, Open Graph, JSON-LD. Restyle-free (head only).
import config from "virtual:kit/config";
import { businessJsonLd, jsonLdString } from "../kit/seo/jsonld";
interface Props { title: string; description?: string; image?: string; noindex?: boolean }
const { title, description = "", image, noindex = false } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).toString().replace(/\/$/, "") || site;
const fullTitle = title === "Home" ? config.client.name : `${title} | ${config.client.name}`;
const jsonld = jsonLdString(businessJsonLd(config, site));
const share = image || config.seo.share_image;
const shareUrl = share ? (/^https?:\/\//i.test(share) ? share : new URL(share, Astro.site).toString()) : "";
---
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={config.client.name} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
{shareUrl && <meta property="og:image" content={shareUrl} />}
<meta name="twitter:card" content={shareUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{shareUrl && <meta name="twitter:image" content={shareUrl} />}
<script type="application/ld+json" set:html={jsonld} />
