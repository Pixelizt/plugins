---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" noindex>
  <section class="wrap py-24 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="mt-4 text-muted-text">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-block rounded-md bg-primary px-6 py-3 text-primary-foreground">Back home</a>
  </section>
</Base>
