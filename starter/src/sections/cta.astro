---
// Section "cta". Content: src/content/cta.json.
import { loadDoc } from "../kit/content";
import { CtaDoc } from "../kit/content/docs";
const d = await loadDoc("cta", CtaDoc);
---
<section class="bg-primary py-16 text-primary-foreground">
  <div class="wrap flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div>
      <h2 class="text-3xl font-bold">{d.title}</h2>
      {d.text && <p class="mt-2 opacity-90">{d.text}</p>}
    </div>
    <a href={d.action.href} class="rounded-md bg-background px-6 py-3 font-semibold text-foreground hover:opacity-90">{d.action.label}</a>
  </div>
</section>
