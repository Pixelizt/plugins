---
// Section "hero". Content: src/content/hero.json (CMS doc "hero"). Reskin freely.
import { loadDoc } from "../kit/content";
import { HeroDoc } from "../kit/content/docs";
const d = await loadDoc("hero", HeroDoc);
---
<section class="wrap grid items-center gap-10 py-20 md:grid-cols-2 md:py-28">
  <div>
    {d.eyebrow && <p class="text-sm font-semibold uppercase tracking-widest text-primary">{d.eyebrow}</p>}
    <h1 class="mt-3 text-5xl font-bold md:text-6xl">{d.headline}</h1>
    {d.text && <p class="mt-6 max-w-prose text-lg text-muted-text">{d.text}</p>}
    <div class="mt-8 flex flex-wrap gap-3">
      {d.primary && <a href={d.primary.href} class="rounded-md bg-primary px-6 py-3 font-semibold text-primary-foreground hover:opacity-90">{d.primary.label}</a>}
      {d.secondary && <a href={d.secondary.href} class="rounded-md border border-border px-6 py-3 font-semibold hover:bg-muted">{d.secondary.label}</a>}
    </div>
  </div>
  {d.image && <img src={d.image.src} alt={d.image.alt} class="aspect-[4/5] w-full rounded-lg object-cover" fetchpriority="high" />}
</section>
