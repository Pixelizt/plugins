---
// Section "highlights". Content: src/content/highlights.json. Hidden when empty (rule 4).
import { loadDoc } from "../kit/content";
import { HighlightsDoc } from "../kit/content/docs";
const d = await loadDoc("highlights", HighlightsDoc);
---
{d.items.length > 0 && (
  <section class="bg-muted py-16 text-muted-foreground">
    <div class="wrap">
      {d.title && <h2 class="text-3xl font-bold">{d.title}</h2>}
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {d.items.map((i) => (
          <li class="rounded-lg bg-background p-6 text-foreground">
            <h3 class="text-xl font-semibold">{i.title}</h3>
            <p class="mt-2 text-muted-text">{i.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
