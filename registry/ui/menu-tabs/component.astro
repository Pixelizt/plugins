---
// Category tabs for a menu. Without JS every category stays visible. With JS, arrow keys move the tab.
interface Item { name: string; description?: string; price?: string; meta?: string }
interface Category { id: string; label: string; items: Item[] }
interface Props { title?: string; categories: Category[]; label?: string }
const { title = "", categories, label = "Menu categories" } = Astro.props;
const groups = categories.filter((c) => c.items.length > 0);
const base = groups[0]?.id ?? "menu";
---
{groups.length > 0 && (
  <section class="wrap py-16" data-menu-tabs>
    {title && <h2 class="text-4xl font-bold">{title}</h2>}
    <div role="tablist" aria-label={label} class="mt-8 flex gap-2 overflow-x-auto">
      {groups.map((c, i) => (
        <button
          type="button"
          role="tab"
          id={`${base}-${c.id}-tab`}
          aria-controls={`${base}-${c.id}-panel`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="min-h-11 shrink-0 rounded-full border border-border px-4 py-2 text-sm font-semibold aria-selected:border-primary aria-selected:bg-primary aria-selected:text-primary-foreground"
        >{c.label}</button>
      ))}
    </div>
    {groups.map((c) => (
      <div role="tabpanel" id={`${base}-${c.id}-panel`} aria-labelledby={`${base}-${c.id}-tab`} class="mt-6 grid gap-4" tabindex="0">
        <h3 class="text-2xl font-semibold md:sr-only">{c.label}</h3>
        <ul class="grid gap-4">
          {c.items.map((item) => (
            <li class="rounded-lg border border-border bg-background p-4">
              <div class="flex items-baseline justify-between gap-4">
                <p class="text-lg font-semibold">{item.name}</p>
                {item.price && <p class="shrink-0 font-semibold text-primary">{item.price}</p>}
              </div>
              {item.description && <p class="mt-1 text-muted-text">{item.description}</p>}
              {item.meta && <p class="mt-2 text-sm text-muted-text">{item.meta}</p>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}
<script>
  import "./script.ts";
</script>
