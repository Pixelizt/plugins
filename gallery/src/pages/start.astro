---
import Base from "../layouts/Base.astro";
import { FONT_PAIRS, LIST_NAMES, MENU_TAGS, PALETTES, TYPE_LABEL, VIBE_STARTS, type BusinessType } from "../lib/brief.ts";
import { loadCatalog } from "../lib/catalog.ts";
import { COUNTRIES, CURRENCIES, TIMEZONES } from "../lib/places.ts";

const { entries } = loadCatalog();
const bySlug = (slug: string) => entries.find((entry) => entry.slug === slug);
const pickable = ["menu", "content-lists", "table-booking", "space-booking", "meal-plans", "whatsapp"]
  .map(bySlug)
  .filter((entry) => entry != null);
const included = ["starter", "cms", "admin", "forms"].map(bySlug).filter((entry) => entry != null);
const later = entries.filter((entry) => entry.kind === "module" && entry.status === "later");
const paper = PALETTES[0].colors;
const types = Object.entries(TYPE_LABEL) as [BusinessType, string][];
const listLabel: Record<string, string> = {
  events: "Events",
  offers: "Offers",
  faqs: "Questions",
  reviews: "Reviews",
  gallery: "Photo gallery",
  posts: "Journal",
};
---
<Base
  title="Start a site"
  description="Write a client.yaml brief for a restaurant or café site. The file stays in your browser. Nothing is deployed."
>
  <div class="shell">
    <header class="page-intro">
      <p class="eyebrow">Brief</p>
      <h1>Start a site.</h1>
      <p class="lede">Five short steps. You get a file, not a launch. A developer still runs the kit.</p>
    </header>

    <noscript>
      <p class="noscript">This form builds the file in your browser, so it needs JavaScript. The catalog can be read without it.</p>
    </noscript>

    <form id="brief-form" class="wizard" novalidate>
      <ol class="step-nav">
        <li><button type="button" data-goto="1" aria-current="step"><span class="step-n">1</span> <span class="step-l">Business</span></button></li>
        <li><button type="button" data-goto="2"><span class="step-n">2</span> <span class="step-l">Place</span></button></li>
        <li><button type="button" data-goto="3"><span class="step-n">3</span> <span class="step-l">Look</span></button></li>
        <li><button type="button" data-goto="4" id="plugins"><span class="step-n">4</span> <span class="step-l">Plugins</span></button></li>
        <li><button type="button" data-goto="5"><span class="step-n">5</span> <span class="step-l">File</span></button></li>
      </ol>

      <div>
        <section class="panel" data-step="1">
          <h2>The business</h2>
          <p class="help">The name and the kind of room. English only, for now.</p>
          <div class="fields">
            <label class="span-2">Business name
              <input name="name" type="text" autocomplete="organization" required />
              <span class="error" data-error-for="name"></span>
            </label>
            <label>Folder name
              <input name="slug" type="text" autocomplete="off" spellcheck="false" />
              <span class="hint">Lowercase, used in the repo. Filled from the name until you edit it.</span>
              <span class="error" data-error-for="slug"></span>
            </label>
            <fieldset class="span-2">
              <legend>Type</legend>
              <div class="choices">
                {types.map(([value, label]) => (
                  <label class="choice"><input type="radio" name="type" value={value} /> {label}</label>
                ))}
              </div>
              <span class="error" data-error-for="type"></span>
            </fieldset>
            <label class="span-2">A few words for the feel
              <input name="vibe" type="text" maxlength="80" />
              <span class="hint">Starting points, editable.</span>
              <span class="choices">
                {VIBE_STARTS.map((vibe) => (
                  <button type="button" class="btn-quiet" data-vibe={vibe}>{vibe}</button>
                ))}
              </span>
              <span class="error" data-error-for="vibe"></span>
            </label>
          </div>
          <div class="form-nav"><span></span><button class="btn" type="button" data-next>Continue</button></div>
        </section>

        <section class="panel" data-step="2" hidden>
          <h2>How to find you</h2>
          <p class="help">Public details only. No password, no card, no API key.</p>
          <div class="fields two">
            <label class="span-2">Web address
              <input name="domain" type="text" inputmode="url" autocapitalize="off" spellcheck="false" placeholder="yourcafe.com" />
              <span class="error" data-error-for="domain"></span>
            </label>
            <label class="check span-2"><input name="domainPending" type="checkbox" /> I don’t have a domain yet. Use a temporary .example address.</label>
            <label>Email
              <input name="email" type="email" autocomplete="email" />
              <span class="error" data-error-for="email"></span>
            </label>
            <label>Phone
              <input name="phone" type="tel" autocomplete="tel" />
              <span class="error" data-error-for="phone"></span>
            </label>
            <label>WhatsApp number <span class="hint">optional, public chat link</span>
              <input name="whatsapp" type="tel" autocomplete="tel" />
            </label>
            <label>Phone numbers are checked for
              <select name="phoneRegion">
                <option value="">Choose a country</option>
                {COUNTRIES.map((country) => <option value={country.code}>{country.name}</option>)}
                <option value="OTHER">Other…</option>
              </select>
              <span class="error" data-error-for="phoneRegion"></span>
            </label>
            <label data-region-other hidden>Two-letter country code
              <input name="phoneRegionOther" type="text" maxlength="2" autocapitalize="characters" />
            </label>
            <label class="span-2">Address
              <textarea name="address" autocomplete="street-address"></textarea>
              <span class="hint">If you don’t have it yet, write “Address to be added”.</span>
              <span class="error" data-error-for="address"></span>
            </label>
            <label>Weekday hours
              <input name="hoursWeekday" type="text" placeholder="12:00-22:00" inputmode="numeric" />
              <span class="hint">Monday to Friday, 24-hour. Leave blank if unknown.</span>
              <span class="error" data-error-for="hoursWeekday"></span>
            </label>
            <label>Weekend hours
              <input name="hoursWeekend" type="text" placeholder="10:00-22:30" inputmode="numeric" />
              <span class="error" data-error-for="hoursWeekend"></span>
            </label>
            <label>Time zone
              <input name="timezone" type="text" list="timezones" placeholder="Europe/London" autocapitalize="off" spellcheck="false" />
              <span class="error" data-error-for="timezone"></span>
            </label>
            <label>Currency
              <input name="currency" type="text" list="currencies" maxlength="3" placeholder="GBP" autocapitalize="characters" spellcheck="false" />
              <span class="error" data-error-for="currency"></span>
            </label>
            <label class="span-2">Instagram <span class="hint">optional, full link</span>
              <input name="instagram" type="url" placeholder="https://instagram.com/yourcafe" />
              <span class="error" data-error-for="instagram"></span>
            </label>
            <label class="span-2">Known for <span class="hint">optional, comma separated, only what the business says</span>
              <input name="specialties" type="text" />
            </label>
            <label class="span-2">Dashboard email <span class="hint">optional reference. No password.</span>
              <input name="staffEmail" type="email" autocomplete="email" />
              <span class="error" data-error-for="staffEmail"></span>
            </label>
          </div>
          <datalist id="timezones">{TIMEZONES.map((zone) => <option value={zone} />)}</datalist>
          <datalist id="currencies">{CURRENCIES.map((code) => <option value={code} />)}</datalist>
          <div class="form-nav"><button class="btn-quiet" type="button" data-back>Back</button><button class="btn" type="button" data-next>Continue</button></div>
        </section>

        <section class="panel" data-step="3" hidden>
          <h2>Look and feel</h2>
          <p class="help">Starting points you can edit. The kit turns these into theme tokens. It does not invent a logo.</p>
          <p class="kicker">Palette</p>
          <div class="palettes">
            {PALETTES.map((palette) => (
              <button type="button" class="palette" data-palette={JSON.stringify(palette.colors)} aria-pressed={palette.id === "paper" ? "true" : "false"}>
                <span class="dots" aria-hidden="true">
                  <i style={`background:${palette.colors.primary}`}></i>
                  <i style={`background:${palette.colors.secondary}`}></i>
                  <i style={`background:${palette.colors.accent}`}></i>
                  <i style={`background:${palette.colors.background}`}></i>
                </span>
                {palette.label}
              </button>
            ))}
          </div>
          <div class="color-grid" style="margin-top:0.9rem">
            {(["primary", "secondary", "accent", "background", "foreground", "muted"] as const).map((key) => (
              <label>{key}
                <span class="color-field">
                  <input type="color" value={paper[key]} data-color={key} aria-label={`${key} colour`} />
                  <input type="text" name={key} value={paper[key]} data-color-text={key} spellcheck="false" autocapitalize="off" />
                </span>
                <span class="error" data-error-for={`color-${key}`}></span>
              </label>
            ))}
          </div>
          <div class="preview-card" id="look-preview" style={`background:${paper.background};color:${paper.foreground}`}>
            <strong style="font-family:var(--serif)">The name</strong>
            <span>A sentence in the body type.</span>
            <button type="button" id="look-preview-btn" style={`background:${paper.primary};color:${paper.background}`}>Reserve</button>
          </div>
          <p class="warn" id="contrast-note" hidden></p>
          <p class="kicker" style="margin-top:1rem">Type</p>
          <div class="choices">
            {FONT_PAIRS.map((pair, index) => (
              <label class="choice">
                <input type="radio" name="fonts" value={pair.id} data-heading={pair.heading} data-body={pair.body} checked={index === 0} />
                {pair.label}
                <span class="hint">{pair.heading} / {pair.body}</span>
              </label>
            ))}
          </div>
          <span class="error" data-error-for="fonts"></span>
          <div class="fields two" style="margin-top:1rem">
            <fieldset>
              <legend>Corners</legend>
              <div class="choices">
                {["none", "sm", "md", "lg", "full"].map((value) => (
                  <label class="choice"><input type="radio" name="radius" value={value} checked={value === "md"} /> {value}</label>
                ))}
              </div>
            </fieldset>
            <fieldset>
              <legend>Shadow</legend>
              <div class="choices">
                {["none", "soft", "strong"].map((value) => (
                  <label class="choice"><input type="radio" name="shadow" value={value} checked={value === "soft"} /> {value}</label>
                ))}
              </div>
            </fieldset>
            <fieldset class="span-2">
              <legend>Motion</legend>
              <div class="choices">
                <label class="choice"><input type="radio" name="motion" value="subtle" /> Subtle <span class="hint">No smooth scroll, no 3D</span></label>
                <label class="choice"><input type="radio" name="motion" value="expressive" checked /> Expressive <span class="hint">Smooth scroll on, 3D off</span></label>
                <label class="choice"><input type="radio" name="motion" value="awwwards" /> Awwwards <span class="hint">Smooth scroll and 3D allowed</span></label>
              </div>
            </fieldset>
            <fieldset class="span-2">
              <legend>Hosting</legend>
              <div class="choices">
                <label class="choice"><input type="radio" name="tier" value="free" checked /> Free <span class="hint">Keep-alive cron</span></label>
                <label class="choice"><input type="radio" name="tier" value="paid" /> Paid <span class="hint">No keep-alive workaround</span></label>
              </div>
            </fieldset>
          </div>
          <div class="form-nav"><button class="btn-quiet" type="button" data-back>Back</button><button class="btn" type="button" data-next>Continue</button></div>
        </section>

        <section class="panel" data-step="4" hidden>
          <h2>Plugins</h2>
          <p class="help">CMS, the dashboard and the contact form are already in. Booking numbers, rooms and meal-plan prices are not guessed here.</p>
          <div class="locked">
            {included.map((entry) => (
              <span><strong>{entry.name}</strong> · included</span>
            ))}
          </div>
          <div class="picks" style="margin-top:0.9rem">
            {pickable.map((entry) => (
              <div class="pick">
                <label class="check">
                  <input type="checkbox" name="module" value={entry.slug} checked={entry.slug === "menu"} />
                  <span>
                    <b>{entry.name}</b>
                    <span>{entry.description}</span>
                  </span>
                </label>
                {entry.slug === "content-lists" && (
                  <div class="subpicks">
                    {LIST_NAMES.map((name) => (
                      <label class="check"><input type="checkbox" name="list" value={name} /> {listLabel[name]}</label>
                    ))}
                  </div>
                )}
                {entry.slug === "menu" && (
                  <div class="subpicks">
                    {MENU_TAGS.map((tag) => (
                      <label class="check"><input type="checkbox" name="menuTag" value={tag.key} /> {tag.label}</label>
                    ))}
                  </div>
                )}
                {entry.slug === "whatsapp" && <p class="hint">This is the booking alert, off until env vars exist. The public chat link is the number from the previous step.</p>}
              </div>
            ))}
          </div>
          <span class="error" data-error-for="lists"></span>
          <p class="hint" id="dep-note"></p>
          {later.length > 0 && (
            <div style="margin-top:1rem">
              <p class="kicker">Later</p>
              {later.map((entry) => (
                <p class="locked"><span><strong>{entry.name}</strong> · {entry.description}</span></p>
              ))}
            </div>
          )}
          <div class="form-nav"><button class="btn-quiet" type="button" data-back>Back</button><button class="btn" type="button" data-next>Continue</button></div>
        </section>

        <section class="panel" data-step="5" hidden>
          <div id="review">
            <h2>Your file</h2>
            <p class="help">Create the brief here. You can copy it or download it. It is not sent anywhere.</p>
            <p class="alert" id="form-alert" hidden></p>
            <div class="form-nav">
              <button class="btn-quiet" type="button" data-back>Back</button>
              <button class="btn" type="submit" id="create-brief">Create client.yaml</button>
            </div>
          </div>
          <div id="done" hidden>
            <h2>The brief is ready.</h2>
            <p class="help">This is a file. The site has not been deployed, and no email has been sent.</p>
            <ol class="note-list">
              <li>Save it, or give it to a Pixelizt teammate.</li>
              <li>A developer puts it at <code data-slug-path>clients/&lt;slug&gt;/client.yaml</code> in the plugins repo.</li>
              <li>They run <code data-slug-cmd>node scripts/new-client.mjs &lt;slug&gt;</code>. That creates a project on their computer.</li>
              <li>Supabase, Resend and Vercel are still set up by a person, afterwards.</li>
            </ol>
            <div class="result-actions">
              <button class="btn" type="button" id="copy-yaml">Copy</button>
              <button class="btn-quiet" type="button" id="download-yaml">Download client.yaml</button>
              <button class="btn-quiet" type="button" id="edit-brief">Edit answers</button>
            </div>
            <p class="warn" id="contrast-final" hidden></p>
            <h3>Still to confirm</h3>
            <ul class="note-list" id="note-list"></ul>
            <pre class="yaml" id="yaml-out" tabindex="0"></pre>
            <div class="handoff">
              <h3>If you already work in the repo</h3>
              <p>You can skip this site. The commands are the same either way.</p>
              <pre id="cli-out"></pre>
            </div>
          </div>
        </section>
      </div>
    </form>
  </div>
</Base>

<script>
  import { mountStart } from "../scripts/start-form.ts";
  mountStart();
</script>
