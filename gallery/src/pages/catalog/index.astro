---
import Base from "../../layouts/Base.astro";
import PluginCard from "../../components/PluginCard.astro";
import { CATEGORIES } from "../../lib/categories.ts";
import { loadCatalog } from "../../lib/catalog.ts";

const { entries } = loadCatalog();
const modules = entries.filter((entry) => entry.kind === "module");
const blocks = entries.filter((entry) => entry.kind === "block");
---
<Base
  title="Catalog"
  description="Every Pixelizt Plugins module and registry block, read from catalog.yaml."
>
  <div class="shell">
    <header class="page-intro">
      <p class="eyebrow">Marketplace</p>
      <h1>Catalog</h1>
      <p class="lede">
        {modules.length} modules and {blocks.length} blocks, taken from the repo at build time.
        Filters narrow the list. Without JavaScript, everything is still here.
      </p>
    </header>

    <div class="toolbar">
      <label>
        <span class="visually-hidden">Search the catalog</span>
        <input class="search" id="catalog-search" type="search" placeholder="Search plugins and blocks" autocomplete="off" />
      </label>
      <div class="filters" role="group" aria-label="Categories">
        {CATEGORIES.map((category) => (
          <button type="button" data-filter={category.id} aria-pressed={category.id === "all" ? "true" : "false"}>{category.label}</button>
        ))}
      </div>
    </div>
    <p class="empty" id="catalog-empty" hidden>Nothing in the catalog matches that.</p>
    <div class="grid cards" id="catalog-grid">
      {entries.map((entry) => <PluginCard entry={entry} />)}
    </div>
  </div>
</Base>

<script>
  import { mountCatalog } from "../../scripts/catalog-filter.ts";
  mountCatalog();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
