---
import Base from "../../layouts/Base.astro";
import PluginCard from "../../components/PluginCard.astro";
import { CATEGORIES } from "../../lib/categories.ts";
import { loadCatalog } from "../../lib/catalog.ts";

const { entries } = loadCatalog();
---
<Base title="Catalog" description="Plugins and blocks for a restaurant or café site.">
  <div class="shell">
    <header class="page-intro">
      <h1>Catalog</h1>
    </header>

    <div class="toolbar">
      <label>
        <span class="visually-hidden">Search the catalog</span>
        <input class="search" id="catalog-search" type="search" placeholder="Search" autocomplete="off" />
      </label>
      <div class="filters" role="group" aria-label="Categories">
        {CATEGORIES.map((category) => (
          <button type="button" data-filter={category.id} aria-pressed={category.id === "all" ? "true" : "false"}>{category.label}</button>
        ))}
      </div>
    </div>
    <p class="empty" id="catalog-empty" hidden>No matches.</p>
    <div class="grid cards" id="catalog-grid">
      {entries.map((entry) => <PluginCard entry={entry} />)}
    </div>
  </div>
</Base>

<script>
  import { mountCatalog } from "../../scripts/catalog-filter.ts";
  mountCatalog();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
