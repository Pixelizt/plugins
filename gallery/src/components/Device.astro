---
interface Props { caption?: string }
const { caption = "Interface sketch. Not a photograph of a live site." } = Astro.props;
---
<figure class="device">
  <div class="device-chrome" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="device-screen"><slot /></div>
  <figcaption>{caption}</figcaption>
</figure>
