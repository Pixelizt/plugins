# WhatsApp Cloud API (Meta), server only. Leave unset and booking alerts stay off.
# Create an app at developers.facebook.com, add the WhatsApp product, and use a system user token.
WHATSAPP_TOKEN=
# The phone number ID from the WhatsApp API setup page (digits, not the display number).
WHATSAPP_PHONE_NUMBER_ID=
# E.164 number that receives booking alerts, digits fine. This is the business, never the visitor.
WHATSAPP_TO=
