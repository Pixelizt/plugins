---
// Section "meal-plan-builder": the plan builder plus the request form. One per page.
// Static markup for the choices (works as a skeleton without JS) + a bundled vanilla script that runs the same
// engine as the server. Hidden when meal plans aren't configured or the menu has nothing to pick (rule 4).
// Copy to src/sections/meal-plan-builder.astro to restyle: keep the data-* attributes, ids and radio names.
import Form from "../../forms/components/Form.astro";
import { forms } from "../../forms/lib/load.ts";
import { loadPlanData, planWarnings } from "../lib/load.ts";
import { DAYS, isConfigured } from "../lib/schema.ts";
import { todayIn } from "../../../kit/lib/time.ts";
import { completeSets, dayName, earliestStart, gridLabel, latestStart, pickOptions, discountFor, pctText } from "../lib/engine.ts";
import { HOOK_NAME } from "../server/quote.ts";
import type { BuilderPayload } from "../lib/client/builder.ts";

const data = await loadPlanData();
for (const w of planWarnings(data)) console.warn(`[meal-plans] ${w}`);
const { conf, copy } = data;

const def = forms[conf.form];
const fix = "Copy it from src/modules/meal-plans/forms/meal-plan.json into src/content/forms.json (see the module's AGENTS.md).";
if (!def) throw new Error(`meal-plan-builder: no form "${conf.form}" in src/content/forms.json. ${fix}`);
if (def.quote !== HOOK_NAME) throw new Error(`meal-plan-builder: form "${conf.form}" must have "quote": "${HOOK_NAME}" so the server re-prices the plan (rule 8). ${fix}`);
const planFieldDef = def.fields.find((f) => f.key === conf.plan_field);
if (!planFieldDef || planFieldDef.type !== "textarea") throw new Error(`meal-plan-builder: form "${conf.form}" needs a textarea field "${conf.plan_field}" (modules.meal-plans.plan_field). ${fix}`);

const sets = completeSets(data);
const pickable = conf.slots.every((s) => s.picks.filter((p) => p.required).every((p) => pickOptions(p.categories, data.items).length > 0));
const show = isConfigured(conf) && (pickable || sets.length > 0);

// lengths grouped for display: a group name shared by several lengths becomes one heading
const groups: { name: string; lengths: typeof conf.lengths }[] = [];
for (const l of conf.lengths) {
  const g = groups.find((x) => x.name === l.group && l.group);
  if (g) g.lengths.push(l);
  else groups.push({ name: l.group, lengths: [l] });
}
const today = todayIn(data.timezone, new Date());
const payload: BuilderPayload = {
  conf, items: data.items, categories: data.categories, sets,
  currency: data.currency, locale: data.locale, timezone: data.timezone, form: conf.form,
};
const firstPlan = conf.plans[0]?.key ?? "";
const legend = "font-heading text-xl font-semibold";
const card = "flex cursor-pointer items-start gap-3 rounded-md border border-border bg-background p-3 has-[:checked]:border-primary has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-ring";
---
{show && (
  <section class="wrap py-16" aria-labelledby="mp-title" data-meal-plan-section>
    <h2 id="mp-title" class="font-heading text-3xl font-bold sm:text-4xl">{data.title}</h2>
    {data.intro && <p class="mt-3 max-w-2xl text-muted-text">{data.intro}</p>}

    <div data-meal-plan data-plan={JSON.stringify(payload)} data-plan-field={conf.plan_field} class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0">
        <p data-mp-nojs class="rounded-md border border-border p-4">{copy.no_js}</p>
        <div data-mp-ui hidden class="space-y-8">
          {sets.length > 0 && (
            <fieldset>
              <legend class={legend}>{copy.mode_label}</legend>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <label class={card}><input type="radio" name="mp-mode" value="set" data-mp="mode" class="mt-1" checked /><span>{copy.mode_set}</span></label>
                <label class={card}><input type="radio" name="mp-mode" value="custom" data-mp="mode" class="mt-1" /><span>{copy.mode_custom}</span></label>
              </div>
            </fieldset>
          )}
          {sets.length > 0 && (
            <fieldset data-mp-sets>
              <legend class={legend}>{copy.sets_label}</legend>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {sets.map((s, i) => (
                  <label class={card}>
                    <input type="radio" name="mp-set" value={s.id} data-mp="set" class="mt-1" checked={i === 0} />
                    <span><span class="block font-semibold">{s.name}</span>{s.description && <span class="block text-sm text-muted-text">{s.description}</span>}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <fieldset>
            <legend class={legend}>{copy.plan_label}</legend>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {conf.plans.map((p) => (
                <label class={card}>
                  <input type="radio" name="mp-plan" value={p.key} data-mp="plan" class="mt-1" checked={p.key === firstPlan} />
                  <span><span class="block font-semibold">{p.label}</span>{p.description && <span class="block text-sm text-muted-text">{p.description}</span>}</span>
                </label>
              ))}
            </div>
          </fieldset>

          {conf.plans.filter((p) => p.combos.length > 1).map((p) => (
            <fieldset data-mp-combos={p.key} hidden={p.key !== firstPlan}>
              <legend class={legend}>{copy.combo_label}</legend>
              <div class="mt-3 flex flex-wrap gap-3">
                {p.combos.map((c, i) => (
                  <label class={card}><input type="radio" name={`mp-combo-${p.key}`} value={c.key} data-mp="combo" data-plan={p.key} class="mt-1" checked={i === 0} /><span>{c.label}</span></label>
                ))}
              </div>
            </fieldset>
          ))}

          <fieldset>
            <legend class={legend}>{copy.length_label}</legend>
            <div class="mt-3 space-y-4">
              {groups.map((g, gi) => (
                <div role="group" aria-label={g.name || undefined}>
                  {g.name && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-muted-text">{g.name}</p>}
                  <div class="grid gap-3 sm:grid-cols-2">
                    {g.lengths.map((l, i) => {
                      const d = discountFor(conf, firstPlan, l.key);
                      return (
                        <label class={card}>
                          <input type="radio" name="mp-length" value={l.key} data-mp="length" class="mt-1" checked={gi === 0 && i === 0} />
                          <span class="grow">
                            <span class="block font-semibold">{l.label}</span>
                            <span class="block text-sm text-muted-text">{gridLabel(conf, l.grid)} · {l.days} days</span>
                            {l.note && <span class="block text-sm text-muted-text">{l.note}</span>}
                          </span>
                          <span data-mp-save={l.key} hidden={!d} class="shrink-0 rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-accent-foreground">{d ? `Save ${pctText(d)}` : ""}</span>
                        </label>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="mp-start" class={`block ${legend}`}>{copy.start_label}</label>
            <input id="mp-start" type="date" min={earliestStart(conf, today)} max={latestStart(conf, today)} aria-describedby="mp-start-info"
              class="mt-2 w-full max-w-xs rounded-md border border-border bg-background px-3 py-2 text-foreground focus-visible:outline-2 focus-visible:outline-ring" />
            <p id="mp-start-info" class="mt-2 text-sm text-muted-text" aria-live="polite"></p>
          </div>

          <div>
            <h3 id="mp-week-h" class={legend}>{copy.week_label}</h3>
            <p class="mt-1 text-sm text-muted-text">{copy.week_note}</p>
            <div role="tablist" aria-labelledby="mp-week-h" data-mp-days class="mt-3 flex flex-wrap gap-2">
              {DAYS.map((d, i) => (
                <button type="button" role="tab" id={`mp-tab-${d}`} data-day={d} aria-controls="mp-day-panel" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}
                  class="rounded-full border border-border px-4 py-2 text-sm font-medium aria-selected:border-primary aria-selected:bg-primary aria-selected:text-primary-foreground">
                  <span aria-hidden="true">{dayName(d, data.locale, "short")}</span><span class="sr-only">{dayName(d, data.locale)}</span>
                </button>
              ))}
            </div>
            <div role="tabpanel" id="mp-day-panel" aria-labelledby="mp-tab-mon" tabindex="0" class="mt-4 focus-visible:outline-2 focus-visible:outline-ring"></div>
            <button type="button" data-mp-copy-day hidden class="mt-4 rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted">Copy this day to every day</button>
          </div>
        </div>
      </div>

      <aside class="self-start rounded-lg border border-border bg-muted p-5 text-muted-foreground lg:sticky lg:top-6" aria-labelledby="mp-sum-h">
        <h3 id="mp-sum-h" class="font-heading text-xl font-semibold">{copy.summary_label}</h3>
        <div data-mp-summary></div>
        <p class="sr-only" role="status" aria-live="polite" data-mp-status></p>
        <p class="mt-4 text-sm">{copy.price_note}</p>
        <a href="#mp-request" class="mt-4 inline-block rounded-md bg-primary px-5 py-2.5 font-semibold text-primary-foreground hover:opacity-90">Continue to your details</a>
      </aside>
    </div>

    <div id="mp-request" class="mt-12 max-w-2xl scroll-mt-6">
      <Form id={conf.form} />
    </div>
  </section>
)}

<script>
  import { mount } from "../lib/client/builder";
  for (const el of document.querySelectorAll<HTMLElement>("[data-meal-plan]")) mount(el);
</script>
