---
// Section "offers". Offers disappear the day after their last day, and one with a future start appears on that day
// (lib/client/expire.ts does this in the browser between rebuilds). Copy to src/sections/offers.astro to restyle.
import config from "virtual:kit/config";
import { loadList } from "../lib/load.ts";
import { todayIn } from "../../../kit/lib/time.ts";
import { offerState } from "../lib/dates.ts";
import { formatDay } from "../lib/format.ts";

const doc = await loadList("offers");
const today = todayIn(config.client.timezone, new Date());
const offers = doc.items.map((o) => ({ o, state: offerState(o, today) })).filter((x) => x.state !== "expired");
const anyLive = offers.some((x) => x.state === "live");
---
{offers.length > 0 && (
  <section class="wrap py-20" data-kit-list="offers" data-tz={config.client.timezone} hidden={!anyLive}>
    <h2 class="text-4xl font-bold">{doc.title}</h2>
    {doc.intro && <p class="mt-3 max-w-2xl text-lg text-muted-text">{doc.intro}</p>}
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {offers.map(({ o, state }) => (
        <article data-offer data-start={o.start || undefined} data-end={o.end || undefined} hidden={state === "scheduled"}
          class="flex flex-col gap-3 rounded-lg border border-border bg-background p-5">
          {o.image && <img src={o.image.src} alt={o.image.alt} loading="lazy" class="aspect-[4/3] w-full rounded-md object-cover" />}
          <h3 class="text-2xl font-bold">{o.title}</h3>
          {o.text && <p class="text-muted-text">{o.text}</p>}
          {o.price && <p class="text-lg font-semibold text-primary">{o.price}</p>}
          {o.end && <p class="text-sm text-muted-text">Until <time datetime={o.end}>{formatDay(o.end)}</time></p>}
          {o.terms && <p class="text-sm text-muted-text">{o.terms}</p>}
        </article>
      ))}
    </div>
  </section>
)}

<script>
  import "../lib/client/expire.ts";
</script>
