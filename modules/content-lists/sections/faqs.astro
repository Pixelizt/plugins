---
// Section "faqs": native <details> accordions (work without JS) plus FAQPage JSON-LD. Copy to src/sections/faqs.astro to restyle.
import { loadList } from "../lib/load.ts";
import { jsonLdString } from "../../../kit/seo/jsonld.ts";
import { faqJsonLd } from "../lib/jsonld.ts";

const doc = await loadList("faqs");
const ld = faqJsonLd(doc.items);
---
{doc.items.length > 0 && (
  <section class="wrap py-20">
    <h2 class="text-4xl font-bold">{doc.title}</h2>
    {doc.intro && <p class="mt-3 max-w-2xl text-lg text-muted-text">{doc.intro}</p>}
    <div class="mt-8 max-w-3xl divide-y divide-border border-y border-border">
      {doc.items.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 whitespace-pre-line text-muted-text">{f.a}</p>
        </details>
      ))}
    </div>
    {ld && <script type="application/ld+json" set:html={jsonLdString(ld)} />}
  </section>
)}
