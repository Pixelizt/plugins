---
// A website form, rendered from src/content/forms.json. Reskin with classes via the `class` prop or by
// copying this into src/components and keeping the data-* attributes and field names (the script relies on them).
import { moduleConfig } from "../../../kit/modules.ts";
import { FormsConfig } from "../lib/schema.ts";
import { forms } from "../lib/load.ts";
import { formHooks } from "../server/hooks.ts";

interface Props { id: string; class?: string }
const { id, class: cls = "" } = Astro.props;
const conf = moduleConfig("forms", FormsConfig);
const def = forms[id];
if (!def) throw new Error(`<Form id="${id}">: no such form in src/content/forms.json`);
if (!conf.forms.includes(id)) throw new Error(`<Form id="${id}">: add "${id}" to client.yaml → modules.forms.forms to make it live`);
if (def.quote && !formHooks()[def.quote]) throw new Error(`<Form id="${id}">: its quote hook "${def.quote}" isn't installed (no src/modules/*/form-hooks.ts exports it)`);
const input = "mt-1 w-full rounded-md border border-border bg-background px-3 py-2 text-foreground focus-visible:outline-2 focus-visible:outline-ring aria-[invalid=true]:border-red-600";
const clientDef = JSON.stringify({ id, region: conf.phone_region, fields: def.fields, success: def.success });
---
<form data-kit-form data-def={clientDef} class:list={["grid gap-4 sm:grid-cols-2", cls]} novalidate>
  {def.fields.map((f) => (
    <div class:list={[f.full || f.type === "textarea" ? "sm:col-span-2" : ""]} data-field={f.key}>
      {f.type === "checkbox" ? (
        <label class="flex items-start gap-2">
          <input type="checkbox" id={`${id}-${f.key}`} name={f.key} required={f.required} class="mt-1" aria-describedby={`${id}-${f.key}-error`} />
          <span>{f.label}{f.required && <span aria-hidden="true"> *</span>}</span>
        </label>
      ) : (
        <>
          <label for={`${id}-${f.key}`} class="text-sm font-medium">{f.label}{f.required && <span aria-hidden="true"> *</span>}</label>
          {f.type === "textarea" ? (
            <textarea id={`${id}-${f.key}`} name={f.key} rows={5} required={f.required} placeholder={f.placeholder} class={input} aria-describedby={`${id}-${f.key}-error`} />
          ) : f.type === "select" ? (
            <select id={`${id}-${f.key}`} name={f.key} required={f.required} class={input} aria-describedby={`${id}-${f.key}-error`}>
              <option value="">Choose…</option>
              {f.options!.map((o) => <option value={o}>{o}</option>)}
            </select>
          ) : (
            <input id={`${id}-${f.key}`} name={f.key} type={f.type} required={f.required} placeholder={f.placeholder}
              min={f.min} max={f.max} autocomplete={f.autocomplete ?? (f.type === "email" ? "email" : f.type === "tel" ? "tel" : undefined)}
              inputmode={f.type === "number" ? "numeric" : undefined} class={input} aria-describedby={`${id}-${f.key}-error`} />
          )}
        </>
      )}
      <small id={`${id}-${f.key}-error`} class="mt-1 block text-sm text-red-700" aria-live="polite"></small>
    </div>
  ))}
  <!-- honeypot: hidden from people, filled by bots -->
  <div aria-hidden="true" class="absolute -start-[9999px] h-0 w-0 overflow-hidden"><label>Leave empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
  <div class="sm:col-span-2">
    <button type="submit" class="rounded-md bg-primary px-6 py-3 font-semibold text-primary-foreground hover:opacity-90 disabled:opacity-60">{def.submit}</button>
    <p data-status class="mt-3" role="status" aria-live="polite"></p>
    {def.note && <p class="mt-2 text-sm text-muted-text">{def.note}</p>}
  </div>
</form>

<script>
  import type { FieldDef } from "../lib/schema";

  // The validator carries phone-number data (~45 kB gz), so it loads on first interaction, not with the page.
  // Same lib/validate.ts the server uses (rule 1).
  let validator: Promise<typeof import("../lib/validate")> | null = null;
  const loadValidator = () => (validator ??= import("../lib/validate"));

  type Def = { id: string; region: string; fields: FieldDef[]; success: string };

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-kit-form]")) {
    const def = JSON.parse(form.dataset.def!) as Def;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const value = (f: FieldDef) => {
      const el = form.elements.namedItem(f.key) as HTMLInputElement | null;
      return el ? (el.type === "checkbox" ? el.checked : el.value) : "";
    };
    const mark = (f: FieldDef, msg: string) => {
      const el = form.elements.namedItem(f.key) as HTMLElement | null;
      el?.setAttribute("aria-invalid", msg ? "true" : "false");
      const note = document.getElementById(`${def.id}-${f.key}-error`);
      if (note) note.textContent = msg;
    };
    const check = async (f: FieldDef) => {
      const { checkField, MESSAGES } = await loadValidator();
      const r = checkField(f, value(f), def.region);
      mark(f, r.problem ? MESSAGES[r.problem](f) : "");
      return !r.problem;
    };
    form.addEventListener("focusin", () => void loadValidator(), { once: true });
    for (const f of def.fields) (form.elements.namedItem(f.key) as HTMLElement | null)?.addEventListener("blur", () => void check(f));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const results = await Promise.all(def.fields.map(check));
      const bad = def.fields.filter((_, i) => !results[i]);
      if (bad.length) {
        const first = form.elements.namedItem(bad[0]!.key) as HTMLElement | null;
        first?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
        first?.focus({ preventScroll: true });
        return;
      }
      const fields = Object.fromEntries(def.fields.map((f) => [f.key, value(f)]));
      const gotcha = (form.elements.namedItem("_gotcha") as HTMLInputElement).value;
      const payload: Record<string, unknown> = { form: def.id, fields, page: location.pathname, _gotcha: gotcha };
      // Extension point: a module script on the page may add `payload.quote` (data for the form's quote hook)
      // or cancel the send with preventDefault() after showing its own message.
      if (!form.dispatchEvent(new CustomEvent("kit:before-submit", { cancelable: true, detail: { payload } }))) return;
      button.disabled = true;
      status.textContent = "Sending…";
      try {
        const res = await fetch("/api/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const out = await res.json();
        if (out.ok) {
          form.reset();
          status.textContent = def.success;
        } else {
          const { MESSAGES } = await loadValidator();
          for (const [k, p] of Object.entries(out.fields ?? {})) {
            const f = def.fields.find((x) => x.key === k);
            if (f) mark(f, MESSAGES[p as keyof typeof MESSAGES](f));
          }
          status.textContent = out.error ?? "Something went wrong. Please try again.";
        }
      } catch {
        status.textContent = "Couldn't send. Check your connection and try again.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
