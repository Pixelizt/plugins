# --- booking-core ---
# Who is told about new bookings, requests and customer cancels (comma-separated). Empty = FORMS_EMAIL_TO.
# Never taken from the request (rule 10).
BOOKINGS_EMAIL_TO=
# Signs the "cancel my booking" links in customer emails. 32+ random characters (e.g. `openssl rand -base64 48`).
# Secret. Changing it retires every link already sent. Empty = emails say "call us to cancel" instead.
BOOKING_TOKEN_SECRET=
